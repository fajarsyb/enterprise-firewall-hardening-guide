        <mxCell id="acc_sw2" value="&lt;b&gt;Enterprise Wi-Fi 6 APs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;Multi-Gig (2.5G/5G) PoE++ Switches&lt;br&gt;Corporate SSID (Pegawai) &amp; Guest Wi-Fi&lt;br&gt;Managed via WLAN Controller&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#059669;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="c_access">
          <mxGeometry x="620" y="70" width="460" height="130" as="geometry" />
        </mxCell>

        <mxCell id="acc_sw3" value="&lt;b&gt;Datacenter Top-of-Rack (ToR)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;Dual 10G/25G Redundant ToR Switches&lt;br&gt;Hypervisor ESXi / Proxmox Hosts&lt;br&gt;Production Web, App &amp; DB Clusters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#10B981;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="c_access">
          <mxGeometry x="1160" y="70" width="460" height="130" as="geometry" />
        </mxCell>

        <mxCell id="acc_sw4" value="&lt;b&gt;CCTV &amp; Smart Building IoT&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot;&gt;Isolated PoE Switches for Security&lt;br&gt;IP Cameras, Access Control, Sensors&lt;br&gt;Block SMB Outbound / No Internet Direct&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#06B6D4;strokeWidth=2;fontColor=#F8FAFC;" vertex="1" parent="c_access">
          <mxGeometry x="1700" y="70" width="460" height="130" as="geometry" />
        </mxCell>

