        <mxCell id="e_c_d2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818CF8;strokeWidth=3;" edge="1" parent="1" source="core_sw1" target="dist_pod2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c_d3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818CF8;strokeWidth=3;" edge="1" parent="1" source="core_sw2" target="dist_pod3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_c_d4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#818CF8;strokeWidth=3;" edge="1" parent="1" source="core_sw2" target="dist_pod4"><mxGeometry relative="1" as="geometry" /></mxCell>

