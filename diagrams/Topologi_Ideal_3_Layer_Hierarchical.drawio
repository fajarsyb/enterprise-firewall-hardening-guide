        <mxCell id="e_d_a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=3;" edge="1" parent="1" source="dist_pod3" target="acc_sw3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d_a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10B981;strokeWidth=3;" edge="1" parent="1" source="dist_pod4" target="acc_sw4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- BOTTOM LEGEND -->
        <mxCell id="leg" value="&lt;b&gt;LEGEND KONEKSI:&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color=&quot;#38BDF8&quot;&gt;━ Solid Blue: L2/L3 Physical Trunk&lt;/font&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#F59E0B&quot;&gt;━ Solid Orange: Inbound WAN Edge&lt;/font&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#EF4444&quot;&gt;━ Solid Red: Perimeter Security Path&lt;/font&gt; &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; &lt;font color=&quot;#818CF8&quot;&gt;━ Double Line: MC-LAG / Virtual Chassis 100G&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#475569;strokeWidth=1.5;fontColor=#F8FAFC;fontSize=12;" vertex="1" parent="1">
