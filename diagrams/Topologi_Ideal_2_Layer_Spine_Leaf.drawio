        <!-- TITLE -->
        <mxCell id="title" value="&lt;b&gt;IDEAL &amp; SECURE 2-TIER SPINE-LEAF CLOS FABRIC (MODERN DATACENTER)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#94A3B8&quot; style=&quot;font-size:13px;&quot;&gt;Ultra-Low Latency East-West Traffic | EVPN-VXLAN Overlay | Underlay ECMP Routing | Zero-STP&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontColor=#F8FAFC;" vertex="1" parent="1">
